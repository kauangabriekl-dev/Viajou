# Copie para .env.local e ajuste se precisar. Nunca faça commit de .env.local.

# URL pública do site (SEO, Open Graph, links absolutos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Produção: Postgres gerenciado. Com DATABASE_URL definido, os DB_* abaixo são ignorados.
# Veja docs/deploy.md.
# DATABASE_URL=postgres://usuario:senha@host:5432/viajou
# DB_SSL=true

# Banco H2 local (npm run db:start). Valores padrão abaixo; só aceitam conexões desta máquina.
# Em produção, aponte para um PostgreSQL gerenciado e use uma senha forte.
# DB_HOST=127.0.0.1
# DB_PORT=5435
# DB_NAME=viajou
# DB_USER=viajou
# DB_PASSWORD=viajou

# Pasta das fotos enviadas pelos usuários (padrão: .data/uploads)
# UPLOAD_DIR=

# Java usado pelo H2 (sem isso, usa ../tools/jdk-21 ou o java do PATH)
# JAVA_HOME=
