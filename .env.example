# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase.
# Nunca faça commit de .env.local.

# URL pública do site (usada em SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapas (opcional). Sem chave, o componente de mapa mostra um placeholder.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Mostra seções com dados de demonstração na homepage (desenvolvimento)
NEXT_PUBLIC_SHOW_DEMO_DATA=true

# Mostra "Entrar com Google" (habilite o provedor em Supabase > Authentication > Providers)
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Apenas desenvolvimento com Supabase local (supabase start): permite imagens de 127.0.0.1
# NEXT_IMAGES_ALLOW_LOCAL_IP=true
